{
	"appId": "com.nightowl.hostel",
	"appName": "NightOwl",
	"webDir": "dist",
	"backgroundColor": "#08080d",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DARK"
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"google.com",
				"phone"
			]
		}
	}
}
